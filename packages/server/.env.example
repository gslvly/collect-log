# 服务
PORT=3000
LOG_LEVEL=info

# 持久化根目录；Node 使用其 sqlite3/，ClickHouse 使用其 clickhouse/
DATA_DIR=/tmp/collect-log-data

# ClickHouse（三个账户，见 DESIGN 3.4）
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_INGEST_USER=ch_ingest
CLICKHOUSE_INGEST_PASSWORD=ingest_pw
CLICKHOUSE_META_USER=ch_meta
CLICKHOUSE_META_PASSWORD=meta_pw
CLICKHOUSE_READONLY_USER=ch_readonly
CLICKHOUSE_READONLY_PASSWORD=readonly_pw

# 认证
JWT_SECRET=replace-with-at-least-32-random-characters

# 初始账户，仅首次启动使用；不需要时保持注释
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# CORS，多个 Origin 使用英文逗号分隔
INGEST_ALLOWED_ORIGINS=http://localhost:5173
CONSOLE_ALLOWED_ORIGINS=http://localhost:5173

# 可选限额覆盖示例（默认值见 src/config/limits.ts）
# LIMIT_INGEST_MAX_BODY_BYTES=65536
# LIMIT_QUERY_MAX_ROWS=10000
# LIMIT_AUTH_CAPTCHA_RATE_LIMIT_PER_IP=60
